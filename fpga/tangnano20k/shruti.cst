// Tang Nano 20K pins for fpga/tangnano20k/top.v. The clock, LEDs, button and USB-UART pins
// are the ones Sipeed's examples (github.com/sipeed/TangNano-20K-example) use for those
// parts. The others are pins those examples bring out to external parts (a joystick
// adapter, the RGB LCD connector); check them against the board schematic before wiring.
IO_LOC "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "btn_rst" 88;
IO_PORT "btn_rst" IO_TYPE=LVCMOS33;

IO_LOC "spi_sck" 52;
IO_LOC "spi_mosi" 53;
IO_LOC "spi_cs_n" 71;
IO_LOC "spi_miso" 72;
IO_PORT "spi_sck" IO_TYPE=LVCMOS33;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33;
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "bus[0]" 27;
IO_LOC "bus[1]" 28;
IO_LOC "bus[2]" 29;
IO_LOC "bus[3]" 30;
IO_LOC "bus[4]" 31;
IO_LOC "bus[5]" 32;
IO_LOC "bus[6]" 33;
IO_LOC "bus[7]" 34;
IO_PORT "bus[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "bus[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "bus[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "bus[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "bus[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "bus[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "bus[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "bus[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC "mon[0]" 35;
IO_LOC "mon[1]" 36;
IO_LOC "mon[2]" 37;
IO_LOC "mon[3]" 38;
IO_PORT "mon[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "mon[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "mon[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "mon[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "trig_in" 39;
IO_PORT "trig_in" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "trig_out" 40;
IO_PORT "trig_out" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "usb_uart_tx" 69;
IO_PORT "usb_uart_tx" IO_TYPE=LVCMOS33;

IO_LOC "led_n[0]" 15;
IO_LOC "led_n[1]" 16;
IO_LOC "led_n[2]" 17;
IO_LOC "led_n[3]" 18;
IO_LOC "led_n[4]" 19;
IO_LOC "led_n[5]" 20;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 DRIVE=8;
